diff --git a/src/poc_context.c b/src/poc_context.c
new file mode 100644
index 0000000..d84d4f0
--- /dev/null
+++ b/src/poc_context.c
@@ -0,0 +1,63 @@
+
+#include <stdlib.h>
+#include <string.h>
+#include <assert.h>
+#include "poc_context.h"
+typedef struct { void *slots[10]; } context_t;
+_Thread_local lua_State *moonchipmunk_L;
+static _Thread_local context_t *active;
+static const char key;
+extern void moonchipmunk_enums_free_all(lua_State *);
+static int context_gc(lua_State *L) {
+    context_t *ctx=lua_touserdata(L,1);
+    lua_State *prev=moonchipmunk_L;
+    context_t *old=active;
+    moonchipmunk_L=L; active=ctx;
+    moonchipmunk_enums_free_all(L);
+    for(int i=0;i<10;i++) {free(ctx->slots[i]);ctx->slots[i]=NULL;}
+    moonchipmunk_L=prev;active=old;
+    return 0;
+}
+void moonchipmunk_context_enter(lua_State *L) {
+    lua_rawgetp(L,LUA_REGISTRYINDEX,&key);
+    if(lua_isnil(L,-1)) {
+        lua_pop(L,1);
+        context_t *ctx=lua_newuserdatauv(L,sizeof(*ctx),0);
+        memset(ctx,0,sizeof(*ctx));
+        if(luaL_newmetatable(L,"moonchipmunk.poc.context")) {
+            lua_pushcfunction(L,context_gc);lua_setfield(L,-2,"__gc");
+        }
+        lua_setmetatable(L,-2);
+        lua_pushvalue(L,-1);lua_rawsetp(L,LUA_REGISTRYINDEX,&key);
+    }
+    active=lua_touserdata(L,-1);lua_pop(L,1);
+    moonchipmunk_L=L;
+}
+void *moonchipmunk_context_slot(int slot,size_t size,int fill) {
+    assert(active && slot>=0 && slot<10);
+    if(!active->slots[slot]) {
+        active->slots[slot]=malloc(size);
+        if(!active->slots[slot]) luaL_error(moonchipmunk_L,"context allocation failed");
+        memset(active->slots[slot],fill,size);
+    }
+    return active->slots[slot];
+}
+static int entry(lua_State *L) {
+    lua_State *prev=moonchipmunk_L;context_t *old=active;
+    lua_CFunction fn=lua_tocfunction(L,lua_upvalueindex(1));
+    moonchipmunk_context_enter(L);
+    int n=lua_gettop(L);
+    lua_pushcfunction(L,fn);lua_insert(L,1);
+    int status=lua_pcall(L,n,LUA_MULTRET,0);
+    moonchipmunk_L=prev;active=old;
+    if(status!=LUA_OK) return lua_error(L);
+    return lua_gettop(L);
+}
+void moonchipmunk_setfuncs(lua_State *L,const luaL_Reg *r,int nup) {
+    if(nup) luaL_error(L,"POC supports zero-upvalue native registrations only");
+    for(;r->name;r++) {
+        lua_pushcfunction(L,r->func);
+        lua_pushcclosure(L,entry,1);
+        lua_setfield(L,-2,r->name);
+    }
+}
