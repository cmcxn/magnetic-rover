{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": "../client/node_modules",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "three": [
        "@types/three"
      ],
      "three/*": [
        "@types/three/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
